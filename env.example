# Sao chép file này thành ".env" (bỏ chữ .example) rồi điền giá trị thật vào.
# TUYỆT ĐỐI không commit file ".env" thật lên GitHub — file .gitignore đã chặn sẵn rồi.

# Lấy 2 giá trị này ở Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# (Tuỳ chọn nhưng cần thiết nếu muốn nhập Playlist/Kênh YouTube thật)
# Lấy tại Google Cloud Console > APIs & Services > Credentials
# Nhớ giới hạn (restrict) API key này theo domain Vercel của bạn để tránh bị người khác lạm dụng.
VITE_YOUTUBE_API_KEY=your-youtube-data-api-v3-key
